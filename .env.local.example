# ============================================
# Supabase Configuration
# ============================================
# Получить в: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# NewsAPI
# ============================================
# Получить в: https://newsapi.org/account
# Без ключа приложение работает в мок-режиме
NEWSAPI_KEY=your-newsapi-key

# ============================================
# OpenAI-совместимое API (для бабушки)
# ============================================
# Любой OpenAI-совместимый провайдер (OpenAI, Together, Groq, etc.)
# Без ключа приложение работает в мок-режиме
PROVIDER_API_KEY=your-provider-api-key
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_MODEL=gpt-4o-mini

# ============================================
# DynamoDB (Yandex Cloud Document API)
# ============================================
# Для локальной разработки используется DynamoDB Local
# Yandex Cloud Document API — production
DOCUMENT_API_ENDPOINT=http://localhost:8000
DOCUMENT_API_REGION=ru-central1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
USE_DATABASE=true